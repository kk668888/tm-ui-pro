{
  "name": "@kibus/tm-ui-plus",
  "version": "0.1.0",
  "description": "公司内部基于 ant-design-vue + vxe-table 二次封装的组件库",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@your-company.com/tm-ui.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./table": {
      "types": "./dist/components/table/index.d.ts",
      "import": "./dist/components/table/index.js",
      "require": "./dist/components/table/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "dayjs": "^1.10.5"
  },
  "peerDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@vxe-ui/core": "4.4.18",
    "ant-design-vue": "^4.2.6",
    "vue": "^3.5.0",
    "vxe-pc-ui": "4.16.21",
    "vxe-table": "4.20.7"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.0",
    "@vxe-ui/core": "4.4.18",
    "ant-design-vue": "^4.2.6",
    "csstype": "^3.2.3",
    "jsdom": "^24.0.0",
    "scroll-into-view-if-needed": "^2.2.31",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.12",
    "vue-types": "^3.0.2",
    "vxe-pc-ui": "4.16.21",
    "vxe-table": "4.20.7"
  }
}
