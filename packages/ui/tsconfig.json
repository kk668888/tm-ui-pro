{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "es",
    "baseUrl": ".",
    "types": ["vitest/globals", "node"],
    "paths": {
      "vue-types": ["./node_modules/vue-types"],
      "scroll-into-view-if-needed": ["./node_modules/scroll-into-view-if-needed"],
      "vxe-pc-ui": ["./node_modules/vxe-pc-ui"]
