{
  "name": "tm-ui-new",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:docs": "pnpm --filter @tm/docs dev",
    "dev:demo": "pnpm --filter demo dev",
    "dev": "pnpm dev:docs",
    "build:ui": "pnpm --filter @kibus/tm-ui-plus build",
    "build:demo": "pnpm --filter demo build",
    "build:docs": "pnpm --filter @tm/docs build",
    "build": "pnpm build:ui",
    "test": "pnpm --filter @kibus/tm-ui-plus test",
    "test:coverage": "pnpm --filter @kibus/tm-ui-plus exec vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @kibus/tm-ui-plus exec vue-tsc --noEmit && pnpm --filter demo exec vue-tsc --noEmit",
    "format": "prettier --write \"packages/**/*.{ts,vue}\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build:ui",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.1",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.0"
  },
  "packageManager": "pnpm@11.13.1"
}
