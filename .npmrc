# .npmrc
# shamefully-hoist=false：禁止把所有依赖隐式提升到 node_modules 顶层，
#   隔离“幽灵依赖（phantom deps）”，强制每个子包显式声明其依赖。
shamefully-hoist=false
# strict-peer-dependencies=false：peerDep 缺失时不直接 fail install，
#   由各子包自行管控 peerDep（避免根 install 在子包未就绪时报错）。
strict-peer-dependencies=false
# auto-install-peers=true：自动安装声明的 peerDependencies，
#   提升 DX（开发体验），减少 peerDep 手动安装摩擦。
auto-install-peers=true
